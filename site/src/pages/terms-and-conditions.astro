---
import BaseLayout from '../layouts/BaseLayout.astro'
import CTABlock from '../components/content/CTABlock.astro'
import { fetchSiteSettings } from '../lib/payload'

let settings: any = { phone: '(801) 919-8224', businessName: 'BaseScape', email: 'hello@basescapeutah.com' }
try { settings = { ...settings, ...(await fetchSiteSettings()) } } catch {}
const phone = settings.phone
const businessName = settings.businessName
const smsNumber = '801-919-8224'
---

<BaseLayout
  title="Terms & Conditions"
  description={`SMS terms and conditions for ${businessName}'s text message program — opt-in, opt-out, message frequency, supported carriers, and HELP/STOP keywords.`}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__inner">
      <span class="hero__overline">SMS Program Terms</span>
      <h1 class="hero__title">Terms &amp; Conditions</h1>
      <p class="hero__subtitle">
        These terms apply to text messages you receive from {businessName}. They explain how
        to opt in, how to opt out, what to expect, and which carriers are supported.
      </p>
    </div>
  </section>

  <!-- Terms Content -->
  <section class="section">
    <div class="section__inner section__inner--narrow">

      <div class="policy-block">
        <h2 class="policy-heading">About Our SMS Program</h2>
        <p class="policy-text">
          {businessName} sends text message updates and responses to homeowners about project
          estimates, scheduling, and services offered at <a href="https://basescapeutah.com/">https://basescapeutah.com/</a>.
        </p>
      </div>

      <div class="policy-block">
        <h2 class="policy-heading">Opt-In</h2>
        <p class="policy-text">
          When you opt in to the service, we may send you a message to confirm your signup.
          Message and data rates may apply. Message frequency varies. Text "HELP" for help.
          Text "STOP" to cancel.
        </p>
      </div>

      <div class="policy-block">
        <h2 class="policy-heading">Cancellation (STOP)</h2>
        <p class="policy-text">
          You can cancel this service at any time. Just text "STOP" to {smsNumber}. After you
          send the message "STOP" to us, we will reply to confirm that you have been
          unsubscribed. After this, you will no longer receive messages from us. If you want
          to join again, just sign up as you did the first time, and we will start sending you
          messages again.
        </p>
      </div>

      <div class="policy-block">
        <h2 class="policy-heading">Help (HELP)</h2>
        <p class="policy-text">
          If at any time you forget what keywords are supported, just text "HELP" to {smsNumber}.
          After you send the message "HELP" to us, we will respond with instructions on how to
          use our service and how to unsubscribe.
        </p>
      </div>

      <div class="policy-block">
        <h2 class="policy-heading">Participating Carriers</h2>
        <p class="policy-text">
          Participating carriers: AT&amp;T, Verizon Wireless, Sprint, T-Mobile, U.S. Cellular,
          Boost Mobile, MetroPCS, Virgin Mobile, Alaska Communications Systems (ACS),
          Appalachian Wireless (EKN), Bluegrass Cellular, Cellular One of East Central, IL
          (ECIT), Cellular One of Northeast Pennsylvania, Cricket, Coral Wireless (Mobi PCS),
          COX, Cross, Element Mobile (Flat Wireless), Epic Touch (Elkhart Telephone), GCI,
          Golden State, Hawkeye (Chat Mobility), Hawkeye (NW Missouri), Illinois Valley
          Cellular, Inland Cellular, iWireless (Iowa Wireless), Keystone Wireless (Immix
          Wireless/PC Man), Mosaic (Consolidated or CTC Telecom), Nex-Tech Wireless, NTelos,
          Panhandle Communications, Pioneer, Plateau (Texas RSA 3 Ltd), Revol, RINA, Simmetry
          (TMP Corporation), Thumb Cellular, Union Wireless, United Wireless, Viaero Wireless,
          and West Central (WCC or 5 Star Wireless).
        </p>
        <p class="policy-text">Carriers are not liable for delayed or undelivered messages.</p>
      </div>

      <div class="policy-block">
        <h2 class="policy-heading">Privacy</h2>
        <p class="policy-text">
          If you have any questions regarding privacy, please read our
          <a href="/privacy/">Privacy Policy</a>.
        </p>
      </div>

      <div class="policy-meta">
        <p class="policy-meta__text">Last updated: May 13, 2026</p>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="section section--alt">
    <div class="section__inner">
      <CTABlock
        headline="Questions About Our Texts? Reach Out."
        phone={phone}
        variant="section"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    background: linear-gradient(180deg, var(--color-bgPage) 0%, var(--color-bgAlt) 100%);
  }

  .hero__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding: var(--size-8) var(--size-4);
  }

  @media (min-width: 768px) {
    .hero__inner {
      padding: var(--size-10) var(--size-6);
      max-width: 800px;
    }
  }

  .hero__overline {
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-teal500);
    margin-bottom: var(--size-2);
  }

  .hero__title {
    font-family: var(--font-serif);
    font-weight: 800;
    font-variation-settings: "WONK" 1, "SOFT" 50;
    font-size: clamp(2.5rem, 5vw + 1rem, 4rem);
    line-height: 1.1;
    color: var(--color-textPrimary);
    margin-bottom: var(--size-4);
  }

  .hero__subtitle {
    font-family: var(--font-sans);
    font-size: clamp(1.0625rem, 0.5vw + 0.875rem, 1.25rem);
    line-height: 1.6;
    color: var(--color-textBody);
    max-width: 600px;
  }

  /* Sections */
  .section {
    padding: var(--size-8) 0;
  }

  @media (min-width: 768px) {
    .section {
      padding: var(--size-10) 0;
    }
  }

  .section--alt {
    background: var(--color-bgAlt);
  }

  .section__inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--size-4);
  }

  @media (min-width: 768px) {
    .section__inner {
      padding-inline: var(--size-6);
    }
  }

  .section__inner--narrow {
    max-width: 800px;
  }

  /* Policy Blocks */
  .policy-block {
    margin-bottom: var(--size-7);
  }

  .policy-block:last-of-type {
    margin-bottom: var(--size-5);
  }

  .policy-heading {
    font-family: var(--font-serif);
    font-weight: 700;
    font-variation-settings: "WONK" 0, "SOFT" 100;
    font-size: clamp(1.25rem, 1.5vw + 0.5rem, 1.5rem);
    line-height: 1.3;
    color: var(--color-textPrimary);
    margin-bottom: var(--size-3);
    padding-bottom: var(--size-2);
    border-bottom: 1px solid var(--color-border);
  }

  .policy-text {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-textBody);
    margin-bottom: var(--size-3);
  }

  .policy-text:last-child {
    margin-bottom: 0;
  }

  .policy-text strong {
    color: var(--color-textPrimary);
    font-weight: 600;
  }

  .policy-text a {
    color: var(--color-green600);
    text-decoration: underline;
    text-decoration-color: var(--color-green200);
    text-underline-offset: 2px;
  }

  .policy-text a:hover {
    color: var(--color-green500);
    text-decoration-color: var(--color-green500);
  }

  /* Policy Meta */
  .policy-meta {
    margin-top: var(--size-6);
    padding-top: var(--size-4);
    border-top: 1px solid var(--color-border);
  }

  .policy-meta__text {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-textMuted);
    font-style: italic;
  }
</style>
